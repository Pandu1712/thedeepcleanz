{
	"appId": "com.thedeepcleanz.app",
	"appName": "TheDeep CleanerZ",
	"webDir": "dist/client",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0B1528",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0B1528"
		}
	}
}
