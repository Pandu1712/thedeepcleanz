PORT=4000
NODE_ENV=production
# REQUIRED: long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If missing, the server uses a random secret and everyone is logged out on every restart.
SESSION_SECRET=
ADMIN_USERNAME=admin
# Optional bootstrap admin password (only used while no admin account exists in the database).
# There is NO built-in default password. Create the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=
ADMIN_REQUIRE_OTP=true

# Firebase phone login: the server verifies Firebase ID tokens with this Web API key
# (same value as VITE_FIREBASE_API_KEY in the frontend)
FIREBASE_API_KEY=

# SMS gateway for checkout OTPs (optional; without it OTPs are only emailed to a verified address)
FAST2SMS_API_KEY=

# MySQL Database Settings
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=thedeepcleanerz
DB_PORT=3306

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification SMTP Credentials (Gmail App Password)
EMAIL_USER=thedeepcleanerz.info@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=thedeepcleanerz.info@gmail.com
SMTP_HOST=
SMTP_PORT=587

# WhatsApp Admin Alerts (CallMeBot API)
ADMIN_WHATSAPP_PHONE=919154351636
CALLMEBOT_API_KEY=
WHATSAPP_NOTIFICATIONS_ENABLED=false
